# Everything bootstrap.py fetches or produces. Nothing here belongs in git:
# the archives are ~6 GB and the extracted images are another ~5 GB.
downloads/
edl/
oppo_decrypt/
.venv/
.work/
msm/
releases/

# Unrelated postmarketOS images that happen to live in this directory
*postmarketOS*.img
*postmarketOS*.img.xz

# Local scratch
*.pyc
__pycache__/

# edl runtime cache (contains the device serial)
edl_config.json

# dead: references $ROM/*.img paths that never existed
edl-fix-critical.sh

# Droidian build: sources and artifacts are fetched/generated, only the
# fajita packaging overlay and the build script are tracked
droidian/kernel/
droidian/out/
droidian/local-repo/
droidian-build-tools/
droidian/stage/
droidian/rootfs/
droidian/userdata.img

# Ramdumps pulled by droidian/dump-ramoops.py -- device RAM, regenerable
memory/

# droidian-camera fork: source is cloned and patched, artifacts generated
droidian/camera-src/
droidian/out-adaptation/
droidian/out-camera/
