#!/usr/bin/env bash
# device-goto — put the phone into a named state and wait for it to arrive.
#
# A thin wrapper over device.sh, exposed as a command so callers name it instead
# of hardcoding a path into the repo. That is also what lets the test suite
# shadow it on PATH; provision.sh needs no notion of being under test.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$HERE/device.sh" goto "$@"
