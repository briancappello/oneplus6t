#!/usr/bin/env bash
# Device glue for fajita.
#
# Camera: Qt5 ships two camera mediaservice plugins and picks the wrong one.
# libgstcamerabin.so (generic GStreamer) cannot link a source against a vendor
# HAL and fails with "negotiation problem"; libaalcamera.so (libhybris/
# droidmedia) works. Setting backend=aal in /etc/droidian-camera.conf is NOT
# enough -- Qt resolves the service independently of the app's preference.
#
# The plugin must be diverted OUT of the scanned directory. Diverting it to
# <plugin>.unused in place does nothing: QFactoryLoader scans the whole
# directory and tries to load every file regardless of name.
set -euo pipefail

PLUGDIR=/usr/lib/aarch64-linux-gnu/qt5/plugins/mediaservice
PLUG="$PLUGDIR/libgstcamerabin.so"
DISABLED=/usr/lib/aarch64-linux-gnu/qt5/plugins-disabled

if [ -e "$PLUG" ] || [ -e "$DISABLED/libgstcamerabin.so" ]; then
    mkdir -p "$DISABLED"
    if ! dpkg-divert --list | grep -q "plugins-disabled/libgstcamerabin"; then
        dpkg-divert --add --rename --divert "$DISABLED/libgstcamerabin.so" "$PLUG"
    fi
    echo "adaptation-oneplus-fajita: camerabin diverted -> $DISABLED"
fi

# Give Android a shutdown window.
#
# OxygenOS ships ro.build.shutdown_timeout=0 in /vendor/build.prop. Android's
# init reads that as "do not wait", so on shutdown it goes straight to SIGKILL
# on every vendor service:
#
#   init: Shutdown timeout: 0 ms
#   init: Sending signal 9 to service 'vendor.qcrild' ...
#   init: Sending signal 9 to service 'vendor.netmgrd' ...
#
# qcrild is what holds the modem's QMI clients. Killed outright, it never
# releases them, so the modem cannot answer the kernel's sysmon shutdown
# request, never sets its shutdown_ack bit, and gets force-halted with
# rmnet_ipa0 still up -- which wedges that netdev and blocks anything touching
# it in uninterruptible sleep. Shutdown took ~224s, nearly all of it waiting.
#
# With a window, init SIGTERMs first and Android reports finishing in ~3s
# (powerctl_shutdown_time_ms:3188), and shutdown drops to ~49s.
#
# /vendor is read-only and the value is a ro. property, fixed when init starts,
# so it cannot be set afterwards. Bind a patched copy over the container's view
# of the file instead. This is the device's own build.prop with one line
# changed; everything else is passed through untouched.
# Do not wait 30s for a bridge that is never coming.
#
# lxc.service runs lxc-containers start, whose wait_for_bridge() polls
# `for try in $(seq 1 30)` with a 1s sleep for the bridge named by
# lxc.net.0.link in /etc/lxc/default.conf (lxcbr0). It is gated on
# USE_LXC_BRIDGE, which /etc/default/lxc sets to false and
# /etc/default/lxc-net then overrides back to true.
#
# lxcbr0 never appears: lxc-net.service fails on this device ("Perhaps
# ip6tables or your kernel needs to be upgraded"). So the loop always runs to
# exhaustion, costing exactly 30s, on the critical path -- lxc.service gates
# multi-user.target, so it delayed graphical.target by the same 30s every boot.
#
# Nothing here wants the bridge. The android container is configured
# lxc.net.0.type = none. Measured: lxc-containers start 30.29s -> 0.044s.
LXC_NET_DEFAULTS=/etc/default/lxc-net
if [ -f "$LXC_NET_DEFAULTS" ] && grep -q '^USE_LXC_BRIDGE="true"' "$LXC_NET_DEFAULTS"; then
    sed -i 's/^USE_LXC_BRIDGE="true"/USE_LXC_BRIDGE="false"/' "$LXC_NET_DEFAULTS"
    echo "adaptation-oneplus-fajita: disabled the unused lxc bridge wait"
fi

LXC_DIR=/var/lib/lxc/android
VENDOR_PROP="$LXC_DIR/rootfs/vendor/build.prop"
OVERRIDE="$LXC_DIR/vendor-build.prop"
ENTRY="lxc.mount.entry = $OVERRIDE vendor/build.prop none bind,ro 0 0"

if [ -f "$VENDOR_PROP" ] && [ -f "$LXC_DIR/config" ]; then
    if [ ! -f "$OVERRIDE" ] || [ "$VENDOR_PROP" -nt "$OVERRIDE" ]; then
        sed 's/^ro\.build\.shutdown_timeout=0$/ro.build.shutdown_timeout=6/' \
            "$VENDOR_PROP" > "$OVERRIDE"
        echo "adaptation-oneplus-fajita: wrote $OVERRIDE"
    fi
    if ! grep -qF "vendor-build.prop" "$LXC_DIR/config"; then
        printf '%s\n' "$ENTRY" >> "$LXC_DIR/config"
        echo "adaptation-oneplus-fajita: bound patched build.prop into the container"
    fi
fi

# Do not run chre.
#
# /vendor/bin/chre hosts Context Hub nanoapps for Android's ContextHubService,
# which nothing in Droidian runs; sensors go through the sensors HAL and
# sscrpcd, not through it. It is declared `shutdown critical`, and Android P's
# init treats that as: never stop it on sys.powerctl, restart it if anything
# else stops it, and START it at shutdown if it is not running -- so `disabled`
# alone changes nothing (verified: "starting service 'chre'" 0.2s after
# sys.powerctl). It therefore dies only when the container's pid namespace is
# torn down, after init has already killed sscrpcd, the SLPI listener its own
# DSP-side exit needs. Its close() then sits in fastrpc_file_free until the
# driver's kernel-invoke timeout; before that timeout existed, forever, which
# is what kept the container's init, lxc-start and /dev/loop1 alive through
# the whole systemd shutdown. Replace `shutdown critical` with `disabled` and
# it never runs. Same technique as build.prop: a patched copy, bound read-only
# over the container's view of the file.
QCOM_RC="$LXC_DIR/rootfs/vendor/etc/init/hw/init.qcom.rc"
RC_OVERRIDE="$LXC_DIR/init.qcom.rc"
RC_ENTRY="lxc.mount.entry = $RC_OVERRIDE vendor/etc/init/hw/init.qcom.rc none bind,ro 0 0"

if [ -f "$QCOM_RC" ] && [ -f "$LXC_DIR/config" ] && grep -q '^service chre ' "$QCOM_RC"; then
    if [ ! -f "$RC_OVERRIDE" ] || [ "$QCOM_RC" -nt "$RC_OVERRIDE" ] || grep -q '^    shutdown critical$' <(sed -n '/^service chre /,/^$/p' "$RC_OVERRIDE"); then
        # Within the chre block only.
        sed '/^service chre /,/^$/ s/^    shutdown critical$/    disabled/' "$QCOM_RC" > "$RC_OVERRIDE"
        echo "adaptation-oneplus-fajita: wrote $RC_OVERRIDE (chre disabled)"
    fi
    if ! grep -qF "init.qcom.rc" "$LXC_DIR/config"; then
        printf '%s\n' "$RC_ENTRY" >> "$LXC_DIR/config"
        echo "adaptation-oneplus-fajita: bound patched init.qcom.rc into the container"
    fi
fi
