From 738f6cc31b804729ed5ea2cc83f6ee6d822e71e8 Mon Sep 17 00:00:00 2001
From: oneplus6t port <none@localhost>
Date: Sun, 6 Sep 2026 13:15:33 -0600
Subject: [PATCH] arm64: dts: pm8998: let the RTC be written

The stock DT sets qcom,qpnp-rtc-write = <0>. qpnp-rtc.c reads that at
probe and, when it is 0, registers the RTC with read-only ops; only <1>
selects qpnp_rtc_rw_ops, which has set_time. With it read-only,
timekeeper and hwclock --systohc cannot persist the system time to the
PMIC, so every cold boot starts from the RTC's stale value until NTP
corrects it. Android never needs this because its time service writes
the RTC through a vendor path; Droidian's systemd stack goes through
/dev/rtc0.

Phase 1 of the LineageOS 20 port made this edit by hand and then reverted
it; this is the committed form.
---
 arch/arm64/boot/dts/qcom/pm8998.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/pm8998.dtsi b/arch/arm64/boot/dts/qcom/pm8998.dtsi
index b7e17514dafb..155ca587aaa0 100644
--- a/arch/arm64/boot/dts/qcom/pm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8998.dtsi
@@ -119,7 +119,7 @@
 			compatible = "qcom,qpnp-rtc";
 			#address-cells = <1>;
 			#size-cells = <1>;
-			qcom,qpnp-rtc-write = <0>;
+			qcom,qpnp-rtc-write = <1>;
 			qcom,qpnp-rtc-alarm-pwrup = <0>;
 
 			qcom,pm8998_rtc_rw@6000 {
-- 
